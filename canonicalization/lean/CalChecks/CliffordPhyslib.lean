/-
Cross-check against PhysLean's own `Cl(3,0)`:
`Physlib.Relativity.PauliMatrices.CliffordAlgebra` (Eric Wieser) builds the Clifford algebra of
the euclidean form on `Fin 3 → ℝ` and maps it onto the algebra generated by the Pauli matrices.
Here: its quadratic form is this project's `Q3`, and its map agrees with `cliffordToM2`.
-/
import Mathlib
import Physlib.Relativity.PauliMatrices.CliffordAlgebra
import CalChecks.Clifford
import CalChecks.Crosscheck

open Matrix Complex
open PauliMatrix

namespace CalChecks

noncomputable section

/-- PhysLean's quadratic form is the project's `Q3`. -/
theorem physlib_form_eq_Q3 : PauliMatrix.form = Q3 := by
  ext v
  simp [Q3, QuadraticMap.weightedSumSquares_apply, Fin.sum_univ_three]
  ring

/-- On generators, PhysLean's map and `cliffordToM2` give the same matrix. -/
theorem physlib_ofCliffordAlgebra_ι (v : Fin 3 → ℝ) :
    ((PauliMatrix.ofCliffordAlgebra (CliffordAlgebra.ι PauliMatrix.form v) :
      Algebra.adjoin ℝ {σ1, σ2, σ3}) : M2) =
    cliffordToM2 (CliffordAlgebra.ι Q3 v) := by
  rw [cliffordToM2_ι, PauliMatrix.ofCliffordAlgebra, CliffordAlgebra.lift_ι_apply]
  simp only [dotσ, σx_eq_physlib, σy_eq_physlib, σz_eq_physlib, Fin.sum_univ_three,
    LinearMap.add_apply, LinearMap.coe_smulRight, LinearMap.coe_proj, Function.eval,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

/-- The two maps agree on the whole algebra, after identifying the two quadratic forms. -/
theorem physlib_ofCliffordAlgebra_eq (q : CliffordAlgebra PauliMatrix.form) :
    ((PauliMatrix.ofCliffordAlgebra q :
      Algebra.adjoin ℝ {σ1, σ2, σ3}) : M2) =
    cliffordToM2 (CliffordAlgebra.map
      (QuadraticMap.Isometry.ofEq physlib_form_eq_Q3) q) := by
  have h : ((Algebra.adjoin ℝ {σ1, σ2, σ3}).val.comp
      PauliMatrix.ofCliffordAlgebra) =
      cliffordToM2.comp (CliffordAlgebra.map (QuadraticMap.Isometry.ofEq physlib_form_eq_Q3)) := by
    apply CliffordAlgebra.hom_ext
    refine LinearMap.ext fun v => ?_
    simpa [CliffordAlgebra.map_apply_ι] using physlib_ofCliffordAlgebra_ι v
  exact congrArg (fun f => f q) h

end

end CalChecks

#print axioms CalChecks.physlib_form_eq_Q3
#print axioms CalChecks.physlib_ofCliffordAlgebra_ι
#print axioms CalChecks.physlib_ofCliffordAlgebra_eq
